    "KunAvatar": {
      "widget": "KunAvatar",
      "props": {
        "disableFloating": {
          "omit": "Deprecated no-op on the web: KunAvatar renders no floating card. The port starts without it."
        },
        "floatingPosition": {
          "omit": "Deprecated no-op on the web: KunAvatar renders no floating card. The port starts without it."
        },
        "isNavigation": "isNavigation",
        "size": "size",
        "user": "user"
      },
      "events": {},
      "slots": {}
    },
    "KunBadge": {
      "widget": "KunBadge",
      "props": {
        "ariaLabel": "semanticLabel",
        "color": "color",
        "count": "count",
        "max": "max",
        "placement": "placement",
        "show": "show",
        "showZero": "showZero",
        "size": "size",
        "variant": "variant"
      },
      "events": {},
      "slots": {
        "default": "child"
      }
    },
    "KunButton": {
      "widget": "KunButton",
      "props": {
        "ariaLabel": "semanticLabel",
        "color": "color",
        "disabled": "disabled",
        "fullWidth": "fullWidth",
        "icon": "icon",
        "iconPosition": "iconPosition",
        "isIconOnly": "isIconOnly",
        "loading": "loading",
        "rounded": "rounded",
