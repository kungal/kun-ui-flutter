        "ariaLabel": "semanticLabel",
        "autoPosition": "autoPosition",
        "closeDelay": "closeDelay",
        "fullWidth": "fullWidth",
        "group": "group",
        "opaque": {
          "omit": "The web's `--kun-surface-opacity` is a CSS variable a site lowers to frost every surface; this port has no such global knob and paints `content1` opaque, so there is no translucency for the prop to override."
        },
        "openDelay": "openDelay",
        "position": "position",
        "rounded": "rounded",
        "showArrow": "showArrow",
        "trigger": "openOn"
      },
      "events": {},
      "slots": {
        "default": "child",
        "trigger": "trigger"
      }
    },
    "KunSelect": {
      "widget": "KunSelect",
      "props": {
        "ariaLabel": "semanticLabel",
        "clearable": "clearable",
        "color": "color",
        "darkBorder": {
          "omit": "No-op since 0.18.0. Every neutral border now resolves to the unified `--color-kun-border` token (the `border-kun` utility), which already flips light↔dark — so the old light-translucent / dark-solid split this prop toggled is gone. Safe to remove from call sites."
        },
        "debounce": "debounce",
        "description": "description",
        "disabled": "disabled",
        "error": "error",
        "fullWidth": "fullWidth",
        "icon": "icon",
        "label": "label",
        "loading": "loading",
        "loadingText": "loadingText",
        "manualFilter": "manualFilter",
        "maxVisibleTags": "maxVisibleTags",
        "modelValue": "value / values",
        "multiple": "KunSelect.multiple",
        "noResultText": "noResultText",
        "options": "options",
        "placeholder": "placeholder",
        "popupWidth": "popupWidth",
        "rounded": "rounded",
        "searchable": "searchable",
        "searchPlaceholder": "searchPlaceholder",
        "size": "size"
      },
      "events": {
        "search": "onSearch",
        "set": "onSet",
        "update:modelValue": "onChanged / onValuesChanged"
      },
      "slots": {
        "option": "optionBuilder"
      }
    },
    "KunSkeleton": {
      "widget": "KunSkeleton",
      "props": {
        "animation": "animation",
        "height": "height",
        "loaded": "loaded",
        "rounded": "rounded",
        "variant": "variant",
        "width": "width"
      },
      "events": {},
      "slots": {
        "default": "child"
      }
    },
    "KunSwitch": {
      "widget": "KunSwitch",
      "props": {
        "description": "description",
        "disabled": "disabled",
        "error": "error",
        "label": "label",
        "modelValue": "value",
        "size": "size"
      },
      "events": {
        "update:modelValue": "onChanged"
      },
      "slots": {}
    },
    "KunTab": {
      "widget": "KunTab",
      "props": {
        "align": "align",
        "color": "color",
        "disableAnimation": "disableAnimation",
        "disabled": "disabled",
        "fullWidth": "fullWidth",
        "iconSize": "iconSize",
        "items": "items",
        "modelValue": "value",
        "orientation": "orientation",
        "scrollButtons": "scrollButtons",
        "scrollable": "scrollable",
        "size": "size",
        "variant": "variant"
      },
      "events": {
        "change": {
          "omit": "Fires on exactly the selections update:modelValue fires on, with the same value; onChanged answers both."
        },
        "update:modelValue": "onChanged"
      },
      "slots": {
        "tab": "tabBuilder"
      }
    },
    "KunTextarea": {
      "widget": "KunTextarea",
      "props": {
        "autoGrow": "autoGrow",
        "autofocus": "autofocus",
        "color": "color",
        "darkBorder": {
          "omit": "Declared in Textarea.vue's props but never read by its template — a legacy toggle with no behaviour to port."
        },
        "description": "description",
        "disabled": "disabled",
        "error": "error",
        "hint": {
          "omit": "The web's own deprecated alias of `description`; a new API is not born with it."
        },
        "label": "label",
        "maxHeight": "maxHeight",
        "maxlength": "maxLength",
        "minlength": {
          "omit": "Feeds only the browser's submit-time constraint validation, which the component itself never renders; Flutter has no form submission for it to join."
        },
        "modelValue": "value",
        "placeholder": "placeholder",
        "readonly": "readOnly",
        "required": "required",
        "resize": {
          "omit": "The drag handle is the browser's own textarea chrome (CSS `resize`); Flutter text fields have none, and drawing one would be design upstream never specified. The port renders the web default, `none`."
        },
        "rounded": "rounded",
        "rows": "rows",
        "showCharCount": "showCharCount",
        "size": "size"
      },
      "events": {
        "blur": "onBlur",
        "focus": "onFocus",
        "input": {
          "omit": "Carries the DOM event of each edit; the value it reports reaches onChanged (update:modelValue) on the same edit."
        },
        "update:modelValue": "onChanged"
      },
      "slots": {}
