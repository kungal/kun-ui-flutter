          "omit": "Declared in Card.vue's props but never read by its template — a legacy toggle with no behaviour to port."
        },
        "isHoverable": "isHoverable",
        "isTransparent": "isTransparent",
        "padding": "padding",
        "rounded": "rounded"
      },
      "events": {
        "click": "onTap"
      },
      "slots": {
        "cover": "cover",
        "default": "child",
        "footer": "footer",
        "header": "header"
      }
