    "KunInput": {
      "widget": "KunInput",
      "props": {
        "autofocus": "autofocus",
        "color": "color",
        "darkBorder": {
          "omit": "Declared in Input.vue's props but never read by its template — a legacy toggle with no behaviour to port."
        },
        "description": "description",
        "disabled": "disabled",
        "error": "error",
        "helperText": {
          "omit": "The web's own deprecated alias of `description`; a new API is not born with it."
        },
        "isClearable": "isClearable",
        "isInvalid": "isInvalid",
        "label": "label",
        "modelValue": "value",
        "placeholder": "placeholder",
        "required": "required",
        "revealPassword": "revealPassword",
