    "KunModal": {
      "widget": "KunModal",
      "props": {
        "ariaLabel": "semanticLabel",
        "description": "description",
        "isCloseRequestDismissable": "isCloseRequestDismissable",
        "isDismissable": "isDismissable",
        "isShowCloseButton": "isShowCloseButton",
        "isSwipeDismissable": "isSwipeDismissable",
