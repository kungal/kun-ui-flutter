{
  "note": "How the gallery demonstrates each component. tool/gen_gallery.dart reads this together with ../../contracts/components.manifest.json and fails when the two disagree: every name the manifest claims must appear exactly once, in a demo's `shows`, in `undemoable`, or in `gaps`. The last two are different facts and the coverage page must not blur them -- `undemoable` is permanent and correct (the name has no visual form at all), `gaps` is work not done yet. A component the gallery has not reached needs no entry here (absence is not drift), but a claimed prop is never left silent.",
  "components": {
    "KunButton": {
      "source": "demos/button.dart",
      "demos": [
        {
          "slug": "matrix",
          "title": "Matrix",
          "builder": "buttonMatrix",
          "shows": [
            "props.variant",
            "props.color",
            "slots.default"
          ]
        },
        {
          "slug": "sizes",
          "title": "Sizes",
          "builder": "buttonSizes",
          "shows": [
            "props.size",
            "props.icon",
            "props.isIconOnly",
            "slots.icon"
          ]
        },
        {
          "slug": "states",
          "title": "States",
          "builder": "buttonStates",
          "shows": [
            "props.loading",
            "props.disabled",
            "props.fullWidth"
          ]
        },
        {
          "slug": "rounded",
          "title": "Rounded",
          "builder": "buttonRounded",
          "shows": [
            "props.rounded"
          ]
        }
      ],
      "undemoable": {
        "props.ariaLabel": "An accessible name has no visual form. The sizes demo sets one on every icon-only button because the contract requires it there, but what is announced is asserted by the widget tests, not seen in a gallery.",
        "events.click": "Every button in every demo carries a live onPressed -- that is the floor this gallery was built to meet. A callback has no appearance of its own to show."
      },
      "gaps": {
        "props.iconPosition": "The sizes demo places its icon in the default left position only."
      }
    },
